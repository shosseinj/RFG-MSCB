\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces ConvNeXt-Tiny encoder structure. (A) Stage-level processing after the one-time ImageNet normalization: Stage 1 uses a $4\times 4$ stride-4 stem, while subsequent stages use $2\times 2$ stride-2 downsampling and repeat ConvNeXt blocks according to depths $[3,3,9,3]$. (B) An individual ConvNeXt block, comprising a $7\times 7$ stride-1 depthwise convolution, channels-last Layer Normalization, linear expansion from $C$ to $4C$, GELU, linear projection from $4C$ to $C$, layer scaling, DropPath, and residual addition.}}{6}{figure.1}\protected@file@percent }
\newlabel{fig:convnext_encoder}{{1}{6}{ConvNeXt-Tiny encoder structure. (A) Stage-level processing after the one-time ImageNet normalization: Stage 1 uses a $4\times 4$ stride-4 stem, while subsequent stages use $2\times 2$ stride-2 downsampling and repeat ConvNeXt blocks according to depths $[3,3,9,3]$. (B) An individual ConvNeXt block, comprising a $7\times 7$ stride-1 depthwise convolution, channels-last Layer Normalization, linear expansion from $C$ to $4C$, GELU, linear projection from $4C$ to $C$, layer scaling, DropPath, and residual addition}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Overall architecture and detailed mechanism of the proposed segmentation framework. The left panel shows the ConvNeXt-Tiny encoder--decoder network with bottleneck FAFEM, Stage-3 RFG-MSCB, and the prediction head. The middle panel illustrates how FAFEM independently processes low- and high-frequency components of the deepest encoder feature, concatenates them, and generates the descriptor $\mathbf {z}_f$. The right panel details RFG-MSCB, in which a lightweight guidance MLP uses $\mathbf {z}_f$ to adaptively weight the $1\times 1$, $3\times 3$, and $5\times 5$ depthwise branches, and bounded residual coupling introduces the guided response as a deviation from ordinary MSCB aggregation.}}{7}{figure.2}\protected@file@percent }
\newlabel{fig:overall_architecture}{{2}{7}{Overall architecture and detailed mechanism of the proposed segmentation framework. The left panel shows the ConvNeXt-Tiny encoder--decoder network with bottleneck FAFEM, Stage-3 RFG-MSCB, and the prediction head. The middle panel illustrates how FAFEM independently processes low- and high-frequency components of the deepest encoder feature, concatenates them, and generates the descriptor $\mathbf {z}_f$. The right panel details RFG-MSCB, in which a lightweight guidance MLP uses $\mathbf {z}_f$ to adaptively weight the $1\times 1$, $3\times 3$, and $5\times 5$ depthwise branches, and bounded residual coupling introduces the guided response as a deviation from ordinary MSCB aggregation}{figure.2}{}}
